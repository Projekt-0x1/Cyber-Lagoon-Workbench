#!/bin/bash -p
set -euo pipefail
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
umask 077
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
PYTHON="$(command -p -v python3)"
if [[ -z "$PYTHON" || ! -x "$PYTHON" ]]; then
  echo "system python3 is unavailable" >&2
  exit 1
fi

canonical_direct_tool() {
  local label="$1"
  local path="$2"
  local directory="${path%/*}"
  local leaf="${path##*/}"
  if [[ "$directory" == "$path" ]]; then directory="."; fi
  directory="$(cd "$directory" && pwd -P)"
  path="$directory/$leaf"
  path="$(command -p readlink -f "$path")"
  if [[ "$path" == "$ROOT" || "$path" == "$ROOT/"* ]]; then
    echo "refusing repo-local Direct tool: $label" >&2
    exit 1
  fi
  if [[ ! -f "$path" || ! -x "$path" ]]; then
    echo "refusing unusable Direct tool: $label" >&2
    exit 1
  fi
  printf '%s\n' "$path"
}

reference_only=0
require_direct=0
reset_reference=0
while (($#)); do
  case "$1" in
    --reference-only) reference_only=1 ;;
    --require-direct) require_direct=1 ;;
    --reset-reference) reset_reference=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -L .state ]]; then
  echo "refusing symlinked workbench directory: .state" >&2
  exit 1
fi
if [[ -e .build ]]; then
  if [[ -L .build || ! -d .build ]]; then
    echo "refusing non-directory workbench build boundary: .build" >&2
    exit 1
  fi
  chmod 700 .build
fi
mkdir -p .state
chmod 700 .state
materialize=("$PYTHON" -I tools/public_materialize_adult.py)
if ((reset_reference)); then materialize+=(--reset); fi
"${materialize[@]}"

if ((reference_only)); then
  echo "CYBER_LAGOON_BUILD status=PASS backend=reference"
  exit 0
fi

cmake_bin="$(type -P cmake || true)"
nvcc_bin="$(type -P nvcc || true)"
cxx_bin="$(type -P c++ || true)"
make_bin="$(type -P make || true)"
if [[ -z "$cmake_bin" || -z "$nvcc_bin" || -z "$cxx_bin" || -z "$make_bin" ]]; then
  if ((require_direct)); then
    echo "Direct build requested but CUDA/CMake/C++/make toolchain is unavailable" >&2
    exit 1
  fi
  echo "CYBER_LAGOON_BUILD status=PASS backend=reference direct=toolchain-unavailable"
  exit 0
fi
cmake_bin="$(canonical_direct_tool cmake "$cmake_bin")"
nvcc_bin="$(canonical_direct_tool nvcc "$nvcc_bin")"
cxx_bin="$(canonical_direct_tool c++ "$cxx_bin")"
make_bin="$(canonical_direct_tool make "$make_bin")"

build_jobs="${SUBSTRATE_BUILD_JOBS:-4}"
if [[ ! "$build_jobs" =~ ^[1-9][0-9]*$ ]]; then
  echo "SUBSTRATE_BUILD_JOBS must be a positive integer" >&2
  exit 2
fi
mkdir -p .build
chmod 700 .build
if [[ -e .build/direct ]]; then
  if [[ -L .build/direct || ! -d .build/direct ]]; then
    echo "refusing non-directory Direct build boundary" >&2
    exit 1
  fi
  chmod 700 .build/direct
fi
mkdir -p .build/home .build/tmp
chmod 700 .build/home .build/tmp
direct_path="${nvcc_bin%/*}:${cxx_bin%/*}:${make_bin%/*}:/usr/bin:/bin"
direct_env=(
  "PATH=$direct_path"
  "HOME=$ROOT/.build/home"
  "TMPDIR=$ROOT/.build/tmp"
)
for env_name in LANG LC_ALL LC_CTYPE CUDA_VISIBLE_DEVICES CUDA_DEVICE_ORDER CUDA_MODULE_LOADING CUDA_CACHE_DISABLE CUDA_CACHE_MAXSIZE NVIDIA_VISIBLE_DEVICES NVIDIA_DRIVER_CAPABILITIES; do
  if [[ -v $env_name ]]; then direct_env+=("$env_name=${!env_name}"); fi
done
run_direct() {
  command -p env -i "${direct_env[@]}" "$@"
}

run_direct "$cmake_bin" -S . -B .build/direct \
  -G "Unix Makefiles" \
  -DCMAKE_MAKE_PROGRAM="$make_bin" \
  -DCMAKE_CXX_COMPILER="$cxx_bin" \
  -DCMAKE_CUDA_COMPILER="$nvcc_bin" \
  -DCMAKE_CUDA_HOST_COMPILER="$cxx_bin" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CUDA_ARCHITECTURES=89
run_direct "$cmake_bin" --build .build/direct \
    --target direct_adult_sitdown direct_recipe_ir_lab \
    -j"$build_jobs"

for artifact in .build/direct/direct_recipe_ir_lab .build/direct/direct_adult_sitdown; do
  if [[ -L "$artifact" || ! -f "$artifact" || ! -x "$artifact" ]]; then
    echo "refusing non-regular Direct build artifact: $artifact" >&2
    exit 1
  fi
done

probe_log=".state/direct-probe.log"
rm -f "$probe_log"
set +e
run_direct "$ROOT/.build/direct/direct_recipe_ir_lab" "$ROOT/experiments/current_recipe.ir" >"$probe_log" 2>&1
probe_status=$?
set -e
cat "$probe_log"

if ((probe_status == 77)); then
  if ((require_direct)); then
    echo "Direct artifacts built, but no CUDA device is available" >&2
    exit 1
  fi
  echo "CYBER_LAGOON_BUILD status=PASS backend=reference direct=built-device-unavailable"
  exit 0
fi
if ((probe_status != 0)); then
  echo "Direct compile-once evaluator failed its startup probe" >&2
  exit "$probe_status"
fi

if [[ -L .state/direct-adult.xcb ]]; then
  echo "refusing symlinked Direct Adult checkpoint" >&2
  exit 1
fi
if [[ -e .state/direct-adult.xcb && ! -f .state/direct-adult.xcb ]]; then
  echo "refusing non-regular Direct Adult checkpoint" >&2
  exit 1
fi
if [[ ! -f .state/direct-adult.xcb ]]; then
  birth_dir="$(mktemp -d .state/.direct-birth.XXXXXX)"
  direct_tmp="$birth_dir/direct-adult.xcb"
  cleanup_birth() {
    rm -f "$direct_tmp"
    rmdir "$birth_dir" 2>/dev/null || true
  }
  trap cleanup_birth EXIT
  if ! run_direct "$ROOT/.build/direct/direct_adult_sitdown" \
      --new "$ROOT/$direct_tmp" \
      --environment-seed 0x63796265726c6167 \
      --once; then
    echo "Direct Adult birth failed" >&2
    exit 1
  fi
  chmod 600 "$direct_tmp"
  mv "$direct_tmp" .state/direct-adult.xcb
  rmdir "$birth_dir"
  trap - EXIT
fi
chmod 600 .state/direct-adult.xcb

echo "CYBER_LAGOON_BUILD status=PASS backend=direct compile_boundary=closed"
